# ==========================================
# EcoPulse / AANG Environment Configuration
# ==========================================

# Data Mode: 'live' untuk memanggil API eksternal asli, 'simulation' untuk memakai mock fixture otomatis saat offline / kuota habis
DATA_MODE=simulation

# Geocoding & Routing Services
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=EcoPulse-Hackathon-App/1.0 (contact@ecopulse.local)
ROUTING_BASE_URL=https://router.project-osrm.org
ORS_API_KEY=

# Air Quality Services (WAQI - aqicn.org)
# Dapatkan token gratis di: https://aqicn.org/data-platform/token/
WAQI_TOKEN=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-leak

# Pilot City Bounding Box [minLat, minLng, maxLat, maxLng]
# Default: Semarang Kota [-7.08, 110.32, -6.93, 110.50]
PILOT_CITY_BBOX=[-7.08, 110.32, -6.93, 110.50]
